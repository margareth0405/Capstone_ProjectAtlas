# Copy these names into the hosting provider's private environment settings.
# Never commit real passwords, app passwords, tokens, or secret keys.

# Django and the public HTTPS hostname
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=repository.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=https://repository.example.edu
DJANGO_TIME_ZONE=Asia/Manila
DJANGO_ADMIN_PATH=replace-with-a-private-admin-path

# Hosted PostgreSQL. Use the provider's private/TLS connection URL.
DATABASE_URL=postgresql://atlas_user:replace-with-a-strong-password@database.example:5432/atlas
DB_SSL_REQUIRE=True
DB_CONN_MAX_AGE=60
MAX_REQUEST_BODY_SIZE_MB=30

# Web concurrency. One process avoids duplicating the AI model in memory;
# Eight threads cover the tested 100-user session workload. Ensure the
# PostgreSQL plan allows at least this many web connections plus maintenance.
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=300

# Private Cloudflare R2 media storage. Store these only as provider secrets.
R2_STORAGE_ENABLED=True
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-new-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-new-r2-secret-access-key
R2_BUCKET_NAME=replace-with-r2-bucket-name
# Account endpoint only; do not append the bucket name.
R2_ENDPOINT_URL=https://replace-with-account-id.r2.cloudflarestorage.com
R2_SIGNED_URL_EXPIRY=300

# HTTPS security. Enable HSTS preload only after every subdomain supports HTTPS.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# Request protection. This Procfile deliberately runs one worker so the local
# cache has one rate-limit authority. These limits are per account/session, so
# 30-50 readers behind one school router are not placed in one shared bucket.
# Use shared Redis before adding workers or instances.
RATE_LIMIT_ENABLED=True
RATE_LIMIT_TRUST_PROXY=True
RATE_LIMIT_SEARCH_REQUESTS=600
RATE_LIMIT_SEARCH_WINDOW=60
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW=300
RATE_LIMIT_REGISTER_REQUESTS=10
RATE_LIMIT_REGISTER_WINDOW=600
RATE_LIMIT_CONTACT_REQUESTS=5
RATE_LIMIT_CONTACT_WINDOW=3600
RATE_LIMIT_EMAIL_REQUESTS=5
RATE_LIMIT_EMAIL_WINDOW=3600
RATE_LIMIT_UPLOAD_REQUESTS=30
RATE_LIMIT_UPLOAD_WINDOW=3600
RATE_LIMIT_AI_REQUESTS=10
RATE_LIMIT_AI_WINDOW=3600
RATE_LIMIT_STAFF_REQUESTS=120
RATE_LIMIT_STAFF_WINDOW=60

# Keep the quantized model in the web deployment; do not download or convert it
# during Render startup.
AI_DETECTION_ENGINE=onnx
AI_DETECTION_PRIMARY_MODEL=bsgcasa/ai-text-detector-distilbert
AI_DETECTION_PRIMARY_REVISION=07a004b5e04fa4d145c73da42ecab754ab6730d0
AI_DETECTION_MODEL_DIR=models/ai_detector
AI_DETECTION_FALLBACK_TO_FAST=False
AI_DETECTION_MAX_UPLOAD_MB=25
HF_HUB_DISABLE_XET=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Real email delivery is required when account verification is mandatory.
ACCOUNT_EMAIL_VERIFICATION=mandatory
ACCOUNT_EMAIL_SUBJECT_PREFIX="[A.T.L.A.S.] "
ACCOUNT_DEFAULT_HTTP_PROTOCOL=https
SITE_ID=1
SITE_DOMAIN=atlas.example.edu
SITE_DISPLAY_NAME=A.T.L.A.S. Digital Sources
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=ATLAS <noreply@example.edu>
EMAIL_HOST=smtp.example.edu
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
EMAIL_HOST_USER=replace-with-the-smtp-user
EMAIL_HOST_PASSWORD=replace-with-the-smtp-app-password

# Institution and privacy details shown publicly.
SUPPORT_EMAIL=repository@example.edu
SUPPORT_HOURS=Monday-Friday, 8:00 AM-5:00 PM
SUPPORT_PHONE=+63 912 345 6789
BUSINESS_NAME=replace-with-the-institution-legal-name
BUSINESS_OPERATOR=replace-with-the-responsible-office
BUSINESS_SERVICE_TYPE=Non-commercial academic Digital Sources service
BUSINESS_COUNTRY=Philippines
BUSINESS_ADDRESS=replace-with-the-institution-address
DATA_PRIVACY_EMAIL=privacy@example.edu
PRIVACY_CONSENT_VERSION=2026-09-20
TEACHER_EMAIL_DOMAINS=deped.gov.ph
