# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_TIME_ZONE=Asia/Manila
DJANGO_ADMIN_PATH=replace-with-a-private-admin-path

# Replace these placeholders with your PostgreSQL credentials.
DATABASE_URL=postgresql://atlas_user:change-me@localhost:5432/atlas
DB_SSL_REQUIRE=False
DB_CONN_MAX_AGE=60

# Private uploaded-media storage. Keep False for local filesystem storage.
# Create new bucket-scoped Object Read & Write credentials before enabling R2.
R2_STORAGE_ENABLED=False
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-new-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-new-r2-secret-access-key
R2_BUCKET_NAME=replace-with-r2-bucket-name
# Account endpoint only; do not append the bucket name.
R2_ENDPOINT_URL=https://replace-with-account-id.r2.cloudflarestorage.com
R2_SIGNED_URL_EXPIRY=300

# Security settings for HTTPS production deployments
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Abuse protection. Trust proxy headers only behind a configured trusted proxy.
RATE_LIMIT_ENABLED=True
RATE_LIMIT_TRUST_PROXY=False
RATE_LIMIT_SEARCH_REQUESTS=600
RATE_LIMIT_SEARCH_WINDOW=60
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW=300
RATE_LIMIT_REGISTER_REQUESTS=5
RATE_LIMIT_REGISTER_WINDOW=3600
RATE_LIMIT_CONTACT_REQUESTS=5
RATE_LIMIT_CONTACT_WINDOW=3600
RATE_LIMIT_EMAIL_REQUESTS=5
RATE_LIMIT_EMAIL_WINDOW=3600
RATE_LIMIT_UPLOAD_REQUESTS=30
RATE_LIMIT_UPLOAD_WINDOW=3600
RATE_LIMIT_AI_REQUESTS=10
RATE_LIMIT_AI_WINDOW=3600
RATE_LIMIT_STAFF_REQUESTS=120
RATE_LIMIT_STAFF_WINDOW=60

# Increment this value when users must accept a revised privacy statement.
PRIVACY_CONSENT_VERSION=2026-09-20

# The deployment-ready DistilBERT classifier runs locally through ONNX Runtime.
# Download its pinned files once with: python manage.py download_ai_model
AI_DETECTION_ENGINE=onnx
AI_DETECTION_PRIMARY_MODEL=bsgcasa/ai-text-detector-distilbert
AI_DETECTION_PRIMARY_REVISION=07a004b5e04fa4d145c73da42ecab754ab6730d0
AI_DETECTION_MODEL_DIR=models/ai_detector
AI_DETECTION_FALLBACK_TO_FAST=False
AI_DETECTION_MAX_UPLOAD_MB=25
HF_HUB_DISABLE_XET=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# django-allauth: none, optional, or mandatory. Configure an SMTP email backend
# before requiring verification in production.
ACCOUNT_EMAIL_VERIFICATION=mandatory
ACCOUNT_EMAIL_SUBJECT_PREFIX="[A.T.L.A.S.] "
ACCOUNT_DEFAULT_HTTP_PROTOCOL=http
SITE_ID=1
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ATLAS <noreply@atlas.local>
SUPPORT_EMAIL=atlastshs@gmail.com
SUPPORT_HOURS=Monday–Friday, 8:00 AM–5:00 PM
# Optional. Include the country code, for example: +63 912 345 6789
SUPPORT_PHONE=
# Public operator details. Add the responsible institution's exact address
# before launch; do not invent a registration number or legal name.
BUSINESS_NAME=ATLAS Digital Repository
BUSINESS_OPERATOR=ATLAS Digital Repository team
BUSINESS_SERVICE_TYPE=Non-commercial academic digital repository
BUSINESS_COUNTRY=Philippines
BUSINESS_ADDRESS=
DATA_PRIVACY_EMAIL=atlastshs@gmail.com
# Comma-separated institutional domains allowed for teacher accounts.
TEACHER_EMAIL_DOMAINS=deped.gov.ph
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
EMAIL_HOST_USER=atlastshs@gmail.com
EMAIL_HOST_PASSWORD=replace-with-a-google-app-password
