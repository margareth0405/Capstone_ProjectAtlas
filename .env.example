# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_TIME_ZONE=Asia/Manila
DJANGO_ADMIN_PATH=replace-with-a-private-admin-path

# Replace these placeholders with your PostgreSQL credentials.
DATABASE_URL=postgresql://postgres:marga@localhost:5432/atlas
DB_SSL_REQUIRE=False
DB_CONN_MAX_AGE=60

# Security settings for HTTPS production deployments
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Increment this value when users must accept a revised privacy statement.
PRIVACY_CONSENT_VERSION=2026-08-11

# django-allauth: none, optional, or mandatory. Configure an SMTP email backend
# before requiring verification in production.
ACCOUNT_EMAIL_VERIFICATION=mandatory
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ATLAS <noreply@atlas.local>
