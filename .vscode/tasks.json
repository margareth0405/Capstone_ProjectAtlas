{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ATLAS: Activate Virtual Environment",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoExit",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& '${workspaceFolder}\\scripts\\start_atlas.ps1' -PrepareOnly; if (-not $?) { exit 1 }; & '${workspaceFolder}\\.venv\\Scripts\\Activate.ps1'; Set-Location '${workspaceFolder}'; Write-Host 'ATLAS virtual environment activated.' -ForegroundColor Green"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "ATLAS: Prepare Local Database",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "${workspaceFolder}\\manage.py",
        "migrate",
        "--noinput"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
